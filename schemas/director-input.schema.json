{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momo.local/schemas/guardian-visual-director-input-v1.json",
  "title": "Guardian Visual Director Input V1",
  "type": "object",
  "required": ["schema_version", "input_meta", "subject", "evidence", "spirit", "mythic_dna"],
  "properties": {
    "schema_version": {"const": "director-input-v1"},
    "input_meta": {
      "type": "object",
      "required": ["id", "stage"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "stage": {"enum": ["explore", "define", "canon", "production"]},
        "language": {"type": "string", "default": "zh-CN"}
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["display_name", "species", "photo_identity"],
      "properties": {
        "display_name": {"type": "string"},
        "species": {"const": "cat"},
        "sex": {"enum": ["male", "female", "unknown"]},
        "photo_identity": {
          "type": "object",
          "required": ["traits"],
          "properties": {
            "traits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "kind", "description", "confidence"],
                "properties": {
                  "id": {"type": "string"},
                  "kind": {"enum": ["ears", "eyes", "coat_color", "marking", "tail", "facial_signature", "fur_accent", "other"]},
                  "description": {"type": "string", "minLength": 1},
                  "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                  "source_image_ids": {"type": "array", "items": {"type": "string"}}
                },
                "additionalProperties": false
              }
            },
            "reference_images": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "role", "uri"],
                "properties": {
                  "id": {"type": "string"},
                  "role": {"enum": ["identity", "costume", "proportion", "palette", "shot"]},
                  "uri": {"type": "string"},
                  "weight": {"type": "number", "minimum": 0, "maximum": 1}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "observation", "confidence"],
        "properties": {
          "id": {"type": "string"},
          "context": {"type": "string"},
          "observation": {"type": "string", "minLength": 1},
          "action": {"type": "string"},
          "outcome": {"type": "string"},
          "signals": {"type": "array", "items": {"type": "string"}},
          "confidence": {"enum": ["high", "medium", "low"]}
        },
        "additionalProperties": false
      }
    },
    "personality_relationship_signals": {"type": "array", "items": {"type": "string"}},
    "spirit": {
      "type": "object",
      "required": ["dominant", "statement"],
      "properties": {
        "dominant": {"type": "string"},
        "secondary": {"type": "array", "items": {"type": "string"}},
        "statement": {"type": "string"},
        "relationship_signal": {"type": "string"},
        "contradiction": {"type": "string"},
        "power": {"type": "string"}
      },
      "additionalProperties": false
    },
    "mythic_dna": {
      "type": "object",
      "required": ["meaning", "motifs", "prohibited_literal_elements"],
      "properties": {
        "meaning": {"type": "string"},
        "motifs": {"type": "array", "items": {"type": "string"}},
        "source_traditions": {"type": "array", "items": {"type": "string"}},
        "prohibited_literal_elements": {"type": "array", "items": {"type": "string"}},
        "culture_review_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "human_identity_direction": {
      "type": "object",
      "required": ["mode", "cultural_context", "geographic_context", "modern_nationality", "ethnicity_reference", "appearance_direction", "provenance_note", "culture_review_required"],
      "properties": {
        "mode": {"enum": ["source_aligned", "user_defined", "fictional_original", "unspecified"]},
        "cultural_context": {"type": "array", "items": {"type": "string"}},
        "geographic_context": {"type": "array", "items": {"type": "string"}},
        "modern_nationality": {"$ref": "#/$defs/resolvedIdentityField"},
        "ethnicity_reference": {"$ref": "#/$defs/resolvedIdentityField"},
        "appearance_direction": {
          "type": "object",
          "required": ["skin_tone", "facial_features", "hair_texture"],
          "properties": {
            "skin_tone": {"type": ["string", "null"]},
            "facial_features": {"type": ["string", "null"]},
            "hair_texture": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "provenance_note": {"type": "string"},
        "culture_review_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "guardian_lore": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "domain": {"type": "string"},
        "blessing": {"type": "string"},
        "bond_blessing": {"type": "string"}
      },
      "additionalProperties": false
    },
    "direction_request": {
      "type": "object",
      "properties": {
        "humanoid_level": {"type": "number", "minimum": 0.8, "maximum": 0.95},
        "target_audience": {"enum": ["western_oc", "east_asian_game_oc", "custom"], "default": "western_oc"},
        "render_style": {"enum": ["western_fantasy_oc_2d", "western_painterly", "2d_anime_oc", "2d_painterly", "stylized_3d", "custom"]},
        "aspect_ratio": {"type": "string"},
        "shot_type": {"type": "string"},
        "subject_occupancy_ratio": {"type": "number", "minimum": 0.5, "maximum": 0.9},
        "headroom_ratio": {"type": "number", "minimum": 0.04, "maximum": 0.2},
        "background_complexity": {"enum": ["minimal", "restrained", "narrative", "detailed"]},
        "background_presentation": {"enum": ["game_character_select_stage", "graphic_field", "minimal_diorama", "narrative_splash"]},
        "variation_note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "canon": {
      "type": "object",
      "properties": {
        "locked_fields": {"type": "object"},
        "reference_image_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resolvedIdentityField": {
      "type": "object",
      "required": ["value", "status"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "status": {"enum": ["explicit_user", "source_supported", "review_required", "not_applicable", "unresolved"]}
      },
      "additionalProperties": false
    }
  }
}
